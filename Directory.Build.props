<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!--Здесь должны быть общие настройки-->

    <!-- C# configuration -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>Latest</LangVersion>
        <Version>0.1.0.0</Version>
        <RootNamespace>GraphLight</RootNamespace>
        <Nullable>enable</Nullable>
        <!-- TODO: Избавиться от предупреждений, связанных с NULL -->
        <!--WarningsAsErrors>CS1998,CA2211,CA1806,IDE1006,CA1305</WarningsAsErrors-->
        <WarningsAsErrors>nullable,CA2201</WarningsAsErrors>
        <AnalysisMode>Recommended</AnalysisMode>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <NoWarn>CA1716,CA1848,CA5369,CA1715</NoWarn>
    </PropertyGroup>

</Project>
